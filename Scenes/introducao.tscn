[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/introducao.gd" id="intro"]
[ext_resource type="Theme" path="res://Assets/tema_menu.tres" id="tema"]

[sub_resource type="Shader" id="Espelho"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D vidro : hint_screen_texture, repeat_disable, filter_nearest;
uniform float intensidade : hint_range(0.0, 1.0) = 0.0;
uniform bool restaurado = false;

void fragment() {
	vec2 p = (UV - vec2(0.5)) * 2.0;
	float borda = max(abs(p.x), abs(p.y) + 0.35 * abs(p.x) * max(0.0, -p.y));
	float mascara = 1.0 - smoothstep(0.87, 1.00, borda);
	float onda = sin(UV.y * 41.0 - TIME * 2.5) + 0.4 * sin(UV.y * 93.0 + TIME * 1.2);
	float desvio = onda * 0.0025 * intensidade * mascara;
	vec3 reflexo = texture(vidro, SCREEN_UV + vec2(desvio, 0.0)).rgb;
	vec3 tom = restaurado ? vec3(0.46, 0.37, 0.73) : vec3(0.10, 0.07, 0.19);
	float brilho = restaurado ? 0.10 * (0.5 + 0.5 * sin(TIME * 1.6 + UV.y * 11.0)) : 0.0;
	vec3 luz = mix(reflexo, tom, (restaurado ? 0.36 : 0.78) * intensidade) + brilho * vec3(0.63, 0.57, 1.0);
	COLOR = vec4(luz, mascara * intensidade);
}"

[sub_resource type="ShaderMaterial" id="Vidro"]
resource_local_to_scene = true
shader = SubResource("Espelho")
shader_parameter/intensidade = 0.0
shader_parameter/restaurado = false

[sub_resource type="Shader" id="Vinheta"]
code = "shader_type canvas_item;
render_mode unshaded;

void fragment() {
	vec2 p = abs(UV * 2.0 - 1.0);
	float sombra = smoothstep(0.30, 1.36, length(p)) * 0.40;
	COLOR = vec4(0.035, 0.021, 0.075, sombra);
}"

[sub_resource type="ShaderMaterial" id="Bordas"]
shader = SubResource("Vinheta")


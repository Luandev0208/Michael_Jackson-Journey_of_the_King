[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/encerramento.gd" id="encerramento"]
[ext_resource type="Theme" path="res://Assets/tema_menu.tres" id="tema"]

[sub_resource type="Shader" id="Vinheta"]
code = "shader_type canvas_item;
render_mode unshaded;

void fragment() {
	vec2 p = abs(UV * 2.0 - 1.0);
	float sombra = smoothstep(0.31, 1.36, length(p)) * 0.39;
	COLOR = vec4(0.035, 0.021, 0.075, sombra);
}"

[sub_resource type="ShaderMaterial" id="Bordas"]
shader = SubResource("Vinheta")

[sub_resource type="StyleBoxFlat" id="Painel"]
content_margin_left = 24.0
content_margin_top = 17.0

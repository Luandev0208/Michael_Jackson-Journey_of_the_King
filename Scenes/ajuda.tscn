[node name="TeclaMoonwalk" type="Label" parent="Conteudo/Comandos"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.79, 0.49, 1)
text = "Shift"

[node name="Moonwalk" type="Label" parent="Conteudo/Comandos"]
layout_mode = 2
text = "Use o moonwalk para recuar e evitar dano por instantes."

[node name="TeclaInteragir" type="Label" parent="Conteudo/Comandos"]

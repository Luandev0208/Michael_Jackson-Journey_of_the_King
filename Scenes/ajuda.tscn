[node name="Mover" type="Label" parent="Conteudo/Comandos"]
layout_mode = 2
text = "Mova Michael e escolha para onde olhar."

[node name="TeclaChute" type="Label" parent="Conteudo/Comandos"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.79, 0.49, 1)

[node name="Chute" type="Label" parent="Conteudo/Comandos"]
layout_mode = 2
text = "Chute e empurre inimigos próximos à sua frente."

[node name="TeclaChapeu" type="Label" parent="Conteudo/Comandos"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.79, 0.49, 1)
